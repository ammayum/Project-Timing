    "lint": "npm run lint --workspace server && npm run lint --workspace client"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0"
  }
}
