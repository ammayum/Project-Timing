{
  "name": "project-billing-system",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "node scripts/dev.mjs",
    "start": "npm run start --workspace server",
