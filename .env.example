NODE_ENV=production
PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_IDLE_TIMEOUT_MINUTES=5

# Local username/password policy.
PASSWORD_MIN_LENGTH=12
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_COUNT=12
PASSWORD_MIN_AGE_DAYS=1
PASSWORD_MAX_FAILED_LOGINS=5
PASSWORD_LOCKOUT_MINUTES=15

FRONTEND_ORIGINS=https://billing.example.com
TRUST_PROXY=1

# MySQL is the production primary write database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=project_billing_app
MYSQL_PASSWORD=replace-with-a-secret-password
MYSQL_DATABASE=project_billing_system

# Optional PostgreSQL connectivity. Inventory/Warehouse writes require MySQL primary.
DATABASE_URL=

# Optional Microsoft SSO retained for compatibility; warehouse production access uses local username/password.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
