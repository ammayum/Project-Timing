NODE_ENV=production
PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_IDLE_TIMEOUT_MINUTES=5
FRONTEND_ORIGINS=https://billing.example.com
TRUST_PROXY=1

# MySQL is the production primary write database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=project_billing_app
MYSQL_PASSWORD=replace-with-a-secret-password
MYSQL_DATABASE=project_billing_system

# Optional PostgreSQL connectivity. It is not the production write path.
DATABASE_URL=

# Optional Microsoft SSO.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
